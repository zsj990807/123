.detail-img {
  margin: 32rpx 28rpx 0;
}

.detail-img .big {
  width: 100%;
  height: 460rpx;
  border-radius: 4rpx;
  background: #EFE9DA;
}

.head {
  padding: 40rpx 36rpx 0;
}

.head .name {
  display: block;
  font-size: 50rpx;
  color: var(--ink);
}

.head .desc {
  display: block;
  margin-top: 14rpx;
  font-size: 28rpx;
  color: var(--muted);
}

.head .meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 24rpx;
  font-size: 24rpx;
  color: var(--olive-deep);
}

.head .flavor {
  color: var(--coral);
}
