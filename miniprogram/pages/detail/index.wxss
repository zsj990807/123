/* ---------- 大图拍立得 ---------- */
.detail-img {
  margin: 32rpx 28rpx 0;
}

.detail-img .big {
  width: 100%;
  height: 460rpx;
  border-radius: 4rpx;
  background: #EFE9DA;
}

/* ---------- 标题区 ---------- */
.head {
  padding: 40rpx 36rpx 0;
}

.head .name {
  display: block;
  font-size: 50rpx;
  color: var(--ink);
}

.name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.edit-link {
  font-size: 26rpx;
  color: var(--coral);
  border-bottom: 2rpx dashed var(--coral);
  padding-bottom: 2rpx;
  flex-shrink: 0;
}

.head .desc {
  display: block;
  margin-top: 14rpx;
  font-size: 28rpx;
  color: var(--muted);
}

.head .meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 24rpx;
  font-size: 24rpx;
  color: var(--olive-deep);
}

.head .flavor {
  color: var(--coral);
}

/* ---------- 主厨寄语 · 便利贴 ---------- */
.chef-note {
  position: relative;
  margin: 36rpx 36rpx 0;
  padding: 44rpx 36rpx 36rpx;
  background: #FFF8D6;
  box-shadow: 0 6rpx 18rpx rgba(180, 160, 70, 0.25);
  transform: rotate(-1.2deg);
}

.tape-note {
  position: absolute;
  top: -14rpx;
  left: 36rpx;
  width: 120rpx;
  height: 30rpx;
  background: var(--tape);
  transform: rotate(-4deg);
  box-shadow: 0 2rpx 6rpx rgba(90, 80, 55, 0.18);
}

.chef-label {
  display: block;
  font-size: 26rpx;
  color: var(--olive-deep);
  letter-spacing: 0.1em;
}

.chef-quote {
  display: block;
  margin-top: 16rpx;
  font-size: 34rpx;
  line-height: 1.6;
  color: var(--ink);
}

/* ---------- 食材 / 做法 通用分节 ---------- */
.section {
  margin: 44rpx 36rpx 0;
}

.section-title {
  display: inline-block;
  font-size: 36rpx;
  color: var(--ink);
  border-bottom: 4rpx solid var(--coral);
  padding-bottom: 4rpx;
  margin-bottom: 28rpx;
}

/* ---------- 食材清单 ---------- */
.ingredients {
  background: var(--paper-2);
  border-radius: 8rpx;
  padding: 8rpx 28rpx;
  box-shadow: 0 3rpx 12rpx rgba(90, 80, 55, 0.08);
}

.ing-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx dashed var(--line);
}

.ing-row:last-child {
  border-bottom: none;
}

.ing-name {
  font-size: 30rpx;
  color: var(--ink);
  flex-shrink: 0;
}

.ing-dots {
  flex: 1;
  height: 0;
  margin: 0 18rpx;
  border-bottom: 2rpx dotted var(--line);
}

.ing-amount {
  font-size: 28rpx;
  color: var(--olive-deep);
  flex-shrink: 0;
}

/* ---------- 做法步骤 ---------- */
.steps {
  padding: 0;
}

.step {
  display: flex;
  align-items: flex-start;
  margin-bottom: 28rpx;
}

.step-num {
  flex-shrink: 0;
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--coral);
  color: #FFFDF7;
  font-size: 28rpx;
  font-weight: 600;
  margin-right: 22rpx;
  box-shadow: 0 2rpx 6rpx rgba(194, 84, 63, 0.35);
}

.step-text {
  flex: 1;
  font-size: 30rpx;
  line-height: 1.65;
  color: var(--ink-2);
  padding-top: 6rpx;
}

/* ---------- 底部加单栏 ---------- */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  background: var(--paper-2);
  box-shadow: 0 -4rpx 18rpx rgba(90, 80, 55, 0.12);
  z-index: 20;
}

.stepper {
  display: flex;
  align-items: center;
  background: var(--paper);
  border: 2rpx solid var(--line);
  border-radius: 44rpx;
  overflow: hidden;
}

.stepper-btn {
  width: 64rpx;
  height: 64rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 40rpx;
  color: var(--ink-2);
}

.qty {
  width: 64rpx;
  text-align: center;
  font-size: 30rpx;
  color: var(--ink);
}

.add-btn {
  flex: 1;
  margin-left: 24rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  background: var(--coral);
  color: var(--paper-2);
  border-radius: 44rpx;
  font-size: 30rpx;
  letter-spacing: 0.12em;
}
