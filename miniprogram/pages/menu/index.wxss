/* ---------- 品牌区 ---------- */
.hero {
  position: relative;
  padding: 60rpx 24rpx 16rpx;
  text-align: center;
  overflow: hidden;
}

/* 顶角两片纸胶带 */
.hero::before,
.hero::after {
  content: '';
  position: absolute;
  top: 30rpx;
  width: 122rpx;
  height: 32rpx;
  background: var(--tape);
  box-shadow: 0 2rpx 8rpx rgba(90, 80, 55, 0.18);
}

.hero::before {
  left: -40rpx;
  transform: rotate(-36deg);
}

.hero::after {
  right: -40rpx;
  transform: rotate(36deg);
}

.brand-title {
  display: block;
  font-size: 108rpx;
  line-height: 1;
  color: var(--ink);
  transform: rotate(-1.6deg);
}

.brand-sub {
  display: block;
  margin-top: 26rpx;
  font-size: 22rpx;
  letter-spacing: 0.18em;
  color: var(--ink-2);
  text-transform: uppercase;
}

.tagline-wrap {
  position: relative;
  margin-top: 34rpx;
}

.tagline {
  display: block;
  font-size: 40rpx;
  color: var(--ink);
  transform: translateX(-58rpx);
}

/* 手绘下划线（原型里的波浪线，P5 换为 PNG 装饰） */
.squiggle {
  width: 300rpx;
  height: 4rpx;
  margin: -8rpx auto 0;
  background: var(--coral);
  opacity: 0.45;
  transform: rotate(-0.7deg);
}

.script-note {
  display: block;
  margin-top: 8rpx;
  padding-right: 16rpx;
  text-align: right;
  font-size: 26rpx;
  color: var(--muted);
}

/* ---------- 分类 ---------- */
.tabs {
  display: flex;
  justify-content: center;
  gap: 18rpx;
  padding: 10rpx 24rpx 28rpx;
}

.tab-item {
  padding: 12rpx 36rpx;
  border: 2rpx solid var(--line);
  border-radius: 44rpx 38rpx 46rpx 40rpx;
  font-size: 28rpx;
  color: var(--ink-2);
}

.tab-item.on {
  background: var(--tape);
  border-color: transparent;
  color: var(--ink);
  font-weight: 600;
}

/* ---------- 列表 ---------- */
.list {
  padding: 4rpx 28rpx 40rpx;
}

.loading,
.empty {
  padding: 90rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: var(--muted);
}

.card {
  margin-bottom: 44rpx;
}

.card .thumb {
  width: 100%;
  height: 300rpx;
  border-radius: 4rpx;
  background: #EFE9DA;
}

.caption {
  padding: 20rpx 8rpx 0;
}

.dish-name {
  display: block;
  font-size: 36rpx;
  color: var(--ink);
}

.dish-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--muted);
}

.meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 18rpx;
}

.meta .time {
  font-size: 24rpx;
  color: var(--olive-deep);
}

.meta .tag {
  font-size: 22rpx;
  color: var(--coral);
  border-bottom: 2rpx dashed var(--coral);
  padding-bottom: 2rpx;
}
